---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	recall(recall)
	plan(plan)
	execute(execute)
	draft(draft)
	critique(critique)
	remember(remember)
	__end__([<p>__end__</p>]):::last
	__start__ --> recall;
	critique -.-> draft;
	critique -.-> remember;
	draft --> critique;
	execute -.-> draft;
	plan --> execute;
	recall --> plan;
	remember --> __end__;
	execute -.-> execute;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
